# ============================================================
# EC2 환경변수 설정 파일 (.env)
# 각 EC2의 ~/app/.env 에 복사하고 실제 값으로 채우세요
# ============================================================

# --- 인프라 EC2 IP (EC2 #5 Private IP) ---
EC2_5_PRIVATE_IP=10.0.x.x

# --- EC2 #3 Private IP (user-speech) ---
EC2_3_PRIVATE_IP=10.0.x.x

# --- EC2 #4 Private IP (learning-media) ---
EC2_4_PRIVATE_IP=10.0.x.x

# --- EC2 #2 Private IP (problem) ---
EC2_2_PRIVATE_IP=10.0.x.x

# --- DB 공통 ---
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
MYSQL_ROOT_PASSWORD=your_root_password

# --- JWT ---
JWT_SECRET=your-jwt-secret-minimum-256-bits-long
JWT_EXPIRATION=3600000

# --- Kakao OAuth ---
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_API_KEY=your_kakao_api_key

# --- AI API Keys ---
GEMINI_API_KEY_EN=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your_google_api_key
OPENAI_API_KEY=your_openai_api_key

# --- EC2 #5 전용 ---
EC2_5_PUBLIC_IP=your_ec2_5_public_ip
